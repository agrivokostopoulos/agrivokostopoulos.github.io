# This repo is public and served by GitHub Pages: every tracked file is readable by anyone.
# Allowlist: only the site itself is tracked. Applications, letters, drafts, LaTeX sources
# and agent files stay local. To publish a new file, put it under assets/ (or add a ! rule).
/*
!/.gitignore
!/.nojekyll
!/index.html
!/README.md
!/package.json
!/Aristeidis_Grivokostopoulos_CV.pdf
!/assets/
!/css/
!/js/

# Never track, even inside allowed folders
.DS_Store
Thumbs.db
~$*
.~lock.*
*_backup_*
*.log
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
node_modules/

